# Dev-only studio env. Vite loads `.env.development` ONLY in serve/dev mode
# (mode=development); the production studio build (mode=production) never reads it,
# so localhost:5500 is not baked into the deployed style.perimeter.org bundle.
#
# This is the IMAGES knob: the sermons module is compiled by the studio's Vite, so
# `format.ts`'s `import.meta.env.VITE_API_URL` resolves to this value, making
# <img> src attributes point at the local perimeter-api in dev.
# The DATA/hooks knob (the runtime API base) is wired separately in WidgetPreview.
VITE_API_URL=http://localhost:5500
