{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/lib/utils": ["../../packages/registry/lib/utils"],
            "@/hooks/*": ["../../packages/registry/hooks/*"],
            "@/components/ui/*": ["../../packages/registry/ui/perimeter/*"],
            "@/*": ["./src/*"]
        },
        "jsx": "preserve",
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["dom", "dom.iterable", "esnext"],
        "resolveJsonModule": true,
        "allowJs": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "incremental": true,
        "noUncheckedIndexedAccess": false,
        "plugins": [{ "name": "next" }]
    },
    "include": [
        "src/**/*",
        "scripts/**/*",
        "next-env.d.ts",
        ".next/types/**/*.ts"
    ],
    "exclude": ["node_modules", "out", ".next"]
}
