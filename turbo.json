{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [
                "dist/**",
                "out/**",
                "public/r/**",
                "registry.json",
                "src/lib/demo-manifest.json",
                "src/lib/demo-imports.ts"
            ]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"]
        },
        "storybook": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"]
        },
        "lint": {},
        "typecheck": {}
    }
}
