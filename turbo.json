{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [
                "dist/**",
                "apps/site/out/**",
                "apps/site/public/r/**",
                "apps/site/src/lib/demo-manifest.json",
                "apps/site/src/lib/demo-imports.ts",
                "packages/registry/public/r/**",
                "packages/registry/registry.json"
            ]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"]
        },
        "storybook": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"]
        },
        "lint": {},
        "typecheck": {}
    }
}
