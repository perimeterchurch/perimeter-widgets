# Copy to .env.local (gitignored) and fill in. Same MP OAuth client the KB /
# perimeter-api use (client id "perimeter-api").

BETTER_AUTH_SECRET=            # openssl rand -base64 32 (fresh; do NOT reuse KB's/Metrics')
# Must match the shell's own origin. The MP OAuth client's redirect URI must be
#   <BETTER_AUTH_URL>/api/auth/oauth2/callback/ministryplatform
# Localhost:5173 is already registered (Phase 0); if the shell runs on :5273,
# register that callback too (Task 1.6) or run the shell on the registered port.
BETTER_AUTH_URL=http://localhost:5273

MP_API_BASEURL=https://ministryplatform.perimeter.org/ministryplatformapi
MP_API_CLIENT=                 # OAuth client id (perimeter-api)
MP_API_SECRET=                 # OAuth client secret

# Impersonation (admin-only, role 2). The shell proxies whitelisted gated-widget
# reads to perimeter-api using its SERVICE key on behalf of a chosen user.
# Server-side only — never exposed to the browser.
API_SECRET_KEY=                # perimeter-api service key (same value perimeter-api uses)

# perimeter-api base (prod: https://api.perimeter.org). Used for impersonation
# AND for the per-request authorization re-check: the shell calls
# GET /api/auth/roles with the signed-in user's MP token to re-read their MP
# security roles, so a role revoked in MP takes effect in ~1 minute instead of
# whenever their 7-day session cookie happens to expire. If this API is
# unreachable the shell falls back to the roles captured at sign-in and logs
# `access.degraded` — it does not lock everyone out.
PERIMETER_API_URL=http://localhost:5500

# Set to 1 to skip the Ministry Platform end-session hop on sign-out (local
# sign-out only). Leave unset in normal operation: without the MP hop, MP's SSO
# session survives and the next sign-in completes silently, which looks like
# sign-out didn't work. Needed only if <BETTER_AUTH_URL>/signin isn't registered
# as a post-logout redirect URI on the MP OAuth client.
# STUDIO_SKIP_MP_END_SESSION=1
