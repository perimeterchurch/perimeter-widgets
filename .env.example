# Perimeter Widgets Environment Variables
# Copy to .env.local for local development: cp .env.example .env.local

# API base URL (defaults to http://localhost:5500 in dev, https://api.perimeter.org in production)
# VITE_API_URL=http://localhost:5500

# API mode: "mock" uses MSW mocks (default), "local" skips MSW and hits real API
# VITE_API_MODE=mock
