# Perimeter Widgets Environment Variables
# Copy to .env.local for local development: cp .env.example .env.local
#
# Naming convention: VITE_PW_<CATEGORY>_<NAME>
#   PW = Perimeter Widgets
#   Categories: API, AUTH, FEATURE, DEBUG

# --- API ---
# Override API base URL (defaults to http://localhost:5500 in dev, https://api.perimeter.org in production)
# VITE_PW_API_BASE_URL=http://localhost:5500

# API mode: "mock" uses MSW mocks (default in storyboard), "local" skips MSW and hits real API
# VITE_PW_API_MODE=mock
