        "@storybook/react-vite": "^10.2.19",
        "@tailwindcss/vite": "^4",
        "@testing-library/jest-dom": "^6",
        "@testing-library/react": "^16",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4",
        "jsdom": "^26",
        "storybook": "^10.2.19",
        "tailwindcss": "^4",
        "typescript": "^5.7",
        "vitest": "^3"
    }
