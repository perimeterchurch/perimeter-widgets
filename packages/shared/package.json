        "sync:tokens": "node scripts/sync-tokens.mjs"
    },
    "dependencies": {
        "@base-ui/react": "^1.3.0",
        "@perimeterchurch/api": "^0.4.0",
        "@tanstack/react-query": "^5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "downshift": "^9.3.2",
        "framer-motion": "^12.38.0",
        "lucide-react": "^0.577.0",
        "openapi-fetch": "^0.13.8",
        "react": "^19",
