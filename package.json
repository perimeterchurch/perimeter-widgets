{
    "name": "perimeter-widgets",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "turbo dev --filter=@perimeter-widgets/site --filter='./widgets/*'",
        "build": "turbo build",
        "postbuild": "tsx scripts/generate-manifest.ts",
        "test": "turbo test",
        "lint": "turbo lint",
        "typecheck": "turbo typecheck",
        "format": "prettier --write .",
        "storybook": "turbo storybook",
        "quality": "turbo typecheck lint test && prettier --check .",
        "site:dev": "pnpm --filter @perimeter-widgets/site dev",
        "site:build": "pnpm --filter @perimeter-widgets/site build",
        "site:typecheck": "pnpm --filter @perimeter-widgets/site typecheck",
        "registry:build": "pnpm --filter @perimeter-widgets/registry build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "turbo": "^2.8.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.1"
    },
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": ">=20"
    }
}
