{
  "name": "perimeter-widgets",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "turbo typecheck lint test && pnpm format:check",
    "release": "tsx packages/release/src/cli.ts",
    "create-widget": "tsx packages/release/src/create-cli.ts",
    "parity:css": "tsx packages/parity/src/report-css.ts",
    "parity:components": "tsx packages/parity/src/report-components.ts",
    "embed-lab": "tsx packages/embed-lab/src/serve.ts",
    "tokens:dtcg": "tsx packages/theme/scripts/write-dtcg.ts"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "^2.11.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "browserslist": "^4.28.7",
      "esbuild": "^0.28.1",
      "form-data": "^4.0.6",
      "js-yaml": "^4.3.2",
      "minimatch@10": "^11.0.1",
      "minimatch@3": "link:./packages/minimatch-compat",
      "minimatch@5": "link:./packages/minimatch-compat",
      "postcss": "^8.5.23",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "toml": "^5.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
